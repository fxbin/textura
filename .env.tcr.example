# Copy this file to .env.tcr on the server and replace the placeholders.

TEXTURA_IMAGE=ccr.ccs.tencentyun.com/textura/me:latest
HOST_HTTP_PORT=80

# Optional: if your TCR repository is private, keep these on the server only.
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_USERNAME=your-tcr-username
TCR_PASSWORD=your-tcr-password
